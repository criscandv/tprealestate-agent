# Aplicacion
APP_NAME="TPRE Agent AI"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/v1
LOG_LEVEL=INFO
LOG_DIR=logs

# Base de datos del agente (PostgreSQL + pgvector)
POSTGRES_SERVER=tprealestate-agent-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tprealestate_agent
POSTGRES_PORT=5432
# Opcional: si se rellena, prevalece sobre POSTGRES_*
DATABASE_URL=postgresql+psycopg2://postgres:postgres@tprealestate-agent-db:5432/tprealestate_agent

# Autenticacion entrante al agente
ALGORITHM=HS256
# API key de servicio que envian los frontends/procesos al agente
SERVICE_API_KEY=""
# Secreto con el que Django firma sus JWT (para verificarlos en el agente)
DJANGO_JWT_SECRET=""

# Conexion con la API de Django (CRM)
DJANGO_API_BASE_URL="http://host.docker.internal:8030/v1"
# API key de servicio que el agente envia a Django (acciones anonimas / de sistema)
DJANGO_SERVICE_API_KEY=""

# OpenAI (LLM principal, swappable)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Langfuse (observabilidad) - proyecto ya desplegado
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=""

# Redis / Celery (tareas en segundo plano)
REDIS_URL="redis://tprealestate-agent-redis:6379/0"
CELERY_BROKER_URL="redis://tprealestate-agent-redis:6379/1"
